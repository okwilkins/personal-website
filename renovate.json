{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "minimumReleaseAge": "1 day",
  "nix": {
    "enabled": true,
    "lockFileMaintenance": {
      "enabled": true,
      "schedule": ["before 4am on monday"]
    },
    "postUpgradeTasks": {
      "commands": ["bash -o pipefail -c 'nix --extra-experimental-features \"nix-command flakes\" eval --raw --no-write-lock-file .#lib.x86_64-linux.syncNixTools | python3 - --install-tools'"],
      "executionMode": "branch",
      "fileFilters": ["package.json", "pnpm-lock.yaml"],
      "installTools": {
        "python": {}
      }
    }
  },
  "packageRules": [
    {
      "description": "Take pnpm and Playwright versions from the Nix flake",
      "matchManagers": ["npm"],
      "matchPackageNames": ["pnpm", "@playwright/test", "playwright", "playwright-core"],
      "enabled": false
    }
  ]
}
